{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "props": ["src/types/props.d.ts"],
      "functions": ["src/types/functions.d.ts"],
      "models": ["src/types/models.d.ts"],
      "contexts": ["src/types/contexts.d.ts"],
      "animations": ["src/types/animations.d.ts"],
      "components": ["src/types/components.d.ts"],
      "response": ["src/types/response.d.ts"],
      "packageJson": ["./package.json"],
      "@/*": ["./src/*"]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
